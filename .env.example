# ── Backend / deployment environment variables (copy to .env, fill in, never commit) ──

# Groq API key (create at console.groq.com/keys). GROQ_API_KEY also accepted.
# Without it, analysis falls back to the deterministic engine (Groq shows 0 tokens).
AI_API_KEY=gsk_xxx

# Random string of 64+ characters. Required in production.
JWT_SECRET=change-me-to-a-random-string-of-at-least-64-characters

# Managed Postgres JDBC URL (Render Postgres). Required in production.
SPRING_DATASOURCE_URL=jdbc:postgresql://host:5432/dbname?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgres

# Spring profile for production: prod
SPRING_PROFILES_ACTIVE=prod

# Optional overrides (defaults are fine for most setups):
# AI_MODEL=openai/gpt-oss-120b
# AI_BASE_URL=https://api.groq.com/openai          # no /v1 — the client appends it
# APP_CORS_ALLOWED_ORIGINS=https://*.vercel.app,http://localhost:5173,http://localhost:3000
# KEEP_ALIVE_ENABLED=true
# KEEP_ALIVE_URLS=https://your-app.vercel.app,https://your-backend.onrender.com/health
# KEEP_ALIVE_INTERVAL_MS=240000
# ANALYSIS_POLL_INTERVAL_MS=3000
# ANALYSIS_REAPER_INTERVAL_MS=60000
