# Frontend environment variables (Vite — baked in at build time).

# Base URL of the backend API, WITHOUT /api/v1 (the axios client appends it).
# Leave empty to call the same origin (dev proxy in vite.config.ts).
# Production (Render): https://your-backend.onrender.com
VITE_API_BASE_URL=https://your-backend.onrender.com
